<Window x:Class="MicLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MicLock.App"
        mc:Ignorable="d"
        Title="MicAnchor - Microphone Volume Lock &amp; Remap"
        Height="670" Width="460"
        MinHeight="600" MinWidth="450"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        Icon="Assets/app.ico">

    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="WindowBackground" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#0D9488"/>
        <SolidColorBrush x:Key="AccentTealHover" Color="#0F766E"/>
        <SolidColorBrush x:Key="AccentTealSoft" Color="#F0FDFA"/>
        <SolidColorBrush x:Key="AccentTealBorder" Color="#CCFBF1"/>

        <!-- Fluent iOS/Win11 Toggle Switch -->
        <Style x:Key="FluentToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12"
                                Background="#CBD5E1" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.15"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentTeal}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Pill Button -->
        <Style x:Key="PresetChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentTealSoft}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentTeal}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentTealBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Record Key Button Style -->
        <Style x:Key="RecordKeyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentTealSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentTealBorder}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCFBF1"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentTealHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fluent Checkbox -->
        <Style x:Key="FluentCheckbox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" Margin="0,0,8,0">
                                <Path x:Name="Check" Data="M3,8 L6.5,11.5 L12.5,4" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentTeal}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Slider Style -->
        <Style x:Key="FluentSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="{StaticResource AccentTeal}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="#E2E8F0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Fill="#FFFFFF" Stroke="{StaticResource AccentTeal}" StrokeThickness="3">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.18"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Active Microphone -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Lock & Volume Control -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Keyboard Remapping Engine -->
                <RowDefinition Height="Auto"/>
                <!-- 4: Preferences & Overlay Behavior -->
                <RowDefinition Height="Auto"/>
                <!-- 5: Minimalist Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Icon -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentTealSoft}" BorderBrush="{StaticResource AccentTealBorder}" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="M12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 Z M6.5,10 C6.5,13.04 8.96,15.5 12,15.5 C15.04,15.5 17.5,13.04 17.5,10 L19,10 C19,13.53 16.39,16.43 13,16.92 L13,19.5 L16.5,19.5 C16.78,19.5 17,19.72 17,20 C17,20.28 16.78,20.5 16.5,20.5 L7.5,20.5 C7.22,20.5 7,20.28 7,20 C7,19.72 7.22,19.5 7.5,19.5 L11,19.5 L11,16.92 C7.61,16.43 5,13.53 5,10 L6.5,10 Z"
                              Fill="{StaticResource AccentTeal}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MicAnchor" FontSize="18" FontWeight="Bold" Foreground="#0F172A" LineHeight="20"/>
                        <TextBlock Text="Volume Lock &amp; Remap" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Elegant Status Indicator -->
                <Border Grid.Column="1"
                        Background="{Binding StatusBackgroundBrush}"
                        BorderBrush="{Binding StatusBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 1. Active Microphone Card -->
            <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Active Microphone" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <Button Grid.Column="1" Command="{Binding CycleRecordingDeviceCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentTeal}" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Content="Cycle Next" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Command="{Binding RefreshDevicesCommand}" Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="11" Cursor="Hand" Content="Refresh"/>
                    </Grid>

                    <ComboBox ItemsSource="{Binding AvailableDevices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              Background="#FFFFFF"
                              Foreground="#0F172A"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              Height="34"
                              Padding="8,5"
                              FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Foreground="#0F172A"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 2. Lock & Volume Control Card -->
            <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Master Protection Switch -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lock Recording Volume" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="Restores level instantly if another app adjusts it" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsLocked, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                    </Grid>

                    <!-- Microphone Mute Switch -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Microphone Mute" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="Quickly mute or unmute your microphone" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsMuted, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                    </Grid>

                    <Border Height="1" Background="#F1F5F9" Margin="0,0,0,10"/>

                    <!-- Target Volume Readout & Slider -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target Level" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TargetVolumePercent, StringFormat='{}{0}%'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentTeal}"/>
                    </Grid>

                    <!-- Slider -->
                    <Slider Minimum="0" Maximum="100"
                            Value="{Binding TargetVolumePercent, Mode=TwoWay}"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            Margin="0,0,0,10"
                            Style="{StaticResource FluentSlider}"/>

                    <!-- Preset Chips -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="50%" Command="{Binding SetPresetCommand}" CommandParameter="50" Style="{StaticResource PresetChipStyle}"/>
                        <Button Grid.Column="1" Content="75%" Command="{Binding SetPresetCommand}" CommandParameter="75" Style="{StaticResource PresetChipStyle}"/>
                        <Button Grid.Column="2" Content="80%" Command="{Binding SetPresetCommand}" CommandParameter="80" Style="{StaticResource PresetChipStyle}"/>
                        <Button Grid.Column="3" Content="90%" Command="{Binding SetPresetCommand}" CommandParameter="90" Style="{StaticResource PresetChipStyle}"/>
                        <Button Grid.Column="4" Content="100%" Command="{Binding SetPresetCommand}" CommandParameter="100" Style="{StaticResource PresetChipStyle}"/>
                    </Grid>

                    <!-- Input Level Meter -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Input Level" FontSize="11" Foreground="#64748B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurrentVolumePercent, Mode=OneWay}"
                                         Height="5" Background="#E2E8F0" Foreground="{StaticResource AccentTeal}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding CurrentVolumePercent, StringFormat='{}{0}%'}"
                                       FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Keyboard Remapping Engine Card -->
            <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Keyboard Remapping" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="Control your mic with a keyboard shortcut or dedicated key" FontSize="10.5" Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsKeyRemapEnabled, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                    </Grid>

                    <!-- Action Selector Dropdown -->
                    <TextBlock Text="Select Action to Remap:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,4,0,4"/>
                    <ComboBox ItemsSource="{Binding RemapActions}"
                              SelectedItem="{Binding SelectedRemapAction, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Height="32"
                              Padding="8,4"
                              FontSize="12"
                              Background="#FFFFFF"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding SelectedRemapAction.Description}"
                               FontSize="10.5"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="2,0,0,8"/>

                    <!-- Assigned Key & Recorder Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Key Display Pill -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Key: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentRemapBindingText}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#38BDF8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Record Key Button -->
                        <Button Grid.Column="1"
                                Command="{Binding StartRecordKeyCommand}"
                                Content="{Binding RecordButtonText}"
                                Style="{StaticResource RecordKeyButtonStyle}"
                                Margin="0,0,6,0"/>

                        <!-- Clear Key Button -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearKeyBindingCommand}"
                                Content="Clear"
                                Style="{StaticResource ActionButtonStyle}"/>
                    </Grid>

                    <!-- Quick Key Presets Dropdown -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Or Choose Preset: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RemapPresets}"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Height="28"
                                  FontSize="11.5"
                                  Padding="6,2"
                                  Background="#FFFFFF"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="1"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Preferences & Behavior Card -->
            <Border Grid.Row="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Preferences &amp; Overlay" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Style="{StaticResource FluentCheckbox}"/>
                        <CheckBox Grid.Column="1" Content="Start Minimized" IsChecked="{Binding StartMinimized, Mode=TwoWay}" Style="{StaticResource FluentCheckbox}"/>
                    </Grid>

                    <CheckBox Content="Show Notifications" IsChecked="{Binding ShowNotifications, Mode=TwoWay}" Style="{StaticResource FluentCheckbox}" Margin="0,0,0,8"/>

                    <Border Height="1" Background="#F1F5F9" Margin="0,4,0,8"/>

                    <!-- SoundSwitch Persistent Overlay Parity Setting -->
                    <CheckBox Content="Keep Overlay Pinned When Muted"
                              IsChecked="{Binding KeepOverlayWhenMuted, Mode=TwoWay}"
                              Style="{StaticResource FluentCheckbox}"
                              Margin="0,0,0,6"/>

                    <Grid Margin="24,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Muted Overlay Opacity" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding OverlayOpacityPercent, Mode=TwoWay}" Style="{StaticResource FluentSlider}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding OverlayOpacityPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="#F1F5F9" Margin="0,8,0,8"/>

                    <!-- Update Checker Row -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Software Updates" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="{Binding UpdateStatusText}" FontSize="10.5" Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CheckForUpdatesCommand}"
                                Content="Check GitHub"
                                Style="{StaticResource ActionButtonStyle}"
                                Height="26"
                                Padding="10,2"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Minimalist Footer -->
            <TextBlock Grid.Row="5"
                       Text="Runs quietly in the system tray"
                       FontSize="11"
                       Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,4,0,4"/>
        </Grid>
    </ScrollViewer>
</Window>
