<Window x:Class="MicLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MicLock.App"
        mc:Ignorable="d"
        Title="MicAnchor - Microphone Volume Lock &amp; Remap"
        Height="540" Width="440"
        MinHeight="480" MinWidth="400"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        Icon="Assets/app.ico">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="WindowBackground" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#0284C7"/>
        <SolidColorBrush x:Key="AccentTealHover" Color="#0369A1"/>
        <SolidColorBrush x:Key="AccentTealSoft" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="AccentTealBorder" Color="#BAE6FD"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <!-- BooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Fluent iOS/Win11 Toggle Switch -->
        <Style x:Key="FluentToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11"
                                Background="#CBD5E1" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.2"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentTeal}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Checkbox -->
        <Style x:Key="FluentCheckbox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" Margin="0,0,8,0">
                                <Path x:Name="Check" Data="M3,7.5 L6,10.5 L11.5,3.5" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentTeal}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Key Chip Button Style -->
        <Style x:Key="KeyChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, monospace"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                                <Setter Property="Foreground" Value="#7DD3FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Slider -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="{StaticResource AccentTeal}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="#E2E8F0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Grid Width="18" Height="18">
                                                    <Ellipse Fill="#FFFFFF" Stroke="{StaticResource AccentTeal}" StrokeThickness="2.5">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.15"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Main Content or Settings Overlay -->
            <RowDefinition Height="*"/>
            <!-- 2: Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Bar (Brand + Status Badge + Settings Gear) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Icon & App Title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentTealSoft}" BorderBrush="{StaticResource AccentTealBorder}" BorderThickness="1" Margin="0,0,10,0">
                    <Path Data="M12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 Z M6.5,10 C6.5,13.04 8.96,15.5 12,15.5 C15.04,15.5 17.5,13.04 17.5,10 L19,10 C19,13.53 16.39,16.43 13,16.92 L13,19.5 L16.5,19.5 C16.78,19.5 17,19.72 17,20 C17,20.28 16.78,20.5 16.5,20.5 L7.5,20.5 C7.22,20.5 7,20.28 7,20 C7,19.72 7.22,19.5 7.5,19.5 L11,19.5 L11,16.92 C7.61,16.43 5,13.53 5,10 L6.5,10 Z"
                          Fill="{StaticResource AccentTeal}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MicAnchor" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Microphone Volume Lock &amp; Remap" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Controls: Status Pill + Settings Gear -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{Binding StatusBackgroundBrush}"
                        BorderBrush="{Binding StatusBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8,3"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Settings Flyout Toggle Button -->
                <Button Command="{Binding ToggleSettingsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="4"
                        ToolTip="Advanced &amp; Settings"
                        VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="15" Foreground="{StaticResource TextSecondary}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1. Body Content -->
        <Grid Grid.Row="1">
            <!-- Normal 3-Section Dashboard View -->
            <StackPanel Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVis}}">
                
                <!-- SECTION 1: LOCK MICROPHONE -->
                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1. LOCK MICROPHONE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <Button Grid.Column="1" Command="{Binding CycleRecordingDeviceCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentTeal}" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Content="Cycle Next ⟳" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Command="{Binding RefreshDevicesCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}" FontSize="11" Cursor="Hand" Content="Refresh"/>
                        </Grid>

                        <!-- Device Selector -->
                        <ComboBox ItemsSource="{Binding AvailableDevices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  Background="#FFFFFF"
                                  Foreground="{StaticResource TextPrimary}"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="1"
                                  Height="32"
                                  Padding="8,4"
                                  FontSize="11.5"
                                  Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Lock Active Mic Endpoint Toggle -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lock Active Microphone" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Enforces default recording device in Windows; blocks external app switches" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsMicLockEnabled, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: LOCK VOLUME -->
                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- Section Header + Master Lock Switch -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="2. LOCK VOLUME" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="Restores level instantly if another app (Discord, Zoom) alters it" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsLocked, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>

                        <!-- Target Volume Readout & Continuous Slider -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Target Level" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TargetVolumePercent, StringFormat='{}{0}%'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentTeal}"/>
                        </Grid>

                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding TargetVolumePercent, Mode=TwoWay}"
                                Margin="0,0,0,6"
                                Style="{StaticResource ModernSlider}"/>

                        <!-- Integrated Live Level Strip -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="INPUT LEVEL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurrentVolumePercent, Mode=OneWay}"
                                         Height="5" Background="#E2E8F0" Foreground="{StaticResource AccentTeal}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding CurrentVolumePercent, StringFormat='{}{0}%'}"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: REMAP AND TOGGLE MUTE -->
                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                    <StackPanel>
                        <!-- Header & Remap Switch -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="3. REMAP &amp; TOGGLE MUTE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="Suppresses Windows key, remaps hardware keys via SendInput" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsKeyRemapEnabled, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>

                        <!-- Action Selector Dropdown -->
                        <ComboBox ItemsSource="{Binding RemapActions}"
                                  SelectedItem="{Binding SelectedRemapAction, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Height="28"
                                  Padding="6,3"
                                  FontSize="11"
                                  Background="#FFFFFF"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="1"
                                  Margin="0,0,0,6"/>

                        <!-- 3-Pillar Linear Remapping Pipeline -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Node 1: Input Key -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="INPUT KEY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <Button Command="{Binding StartCaptureInputCommand}"
                                        Content="{Binding CurrentInputKeyText}"
                                        Style="{StaticResource KeyChipButtonStyle}"
                                        ToolTip="Click to capture new hardware mic key"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="➔" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,10,4,0"/>

                            <!-- Node 2: Remapped Target -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="REMAPPED AS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <Button Command="{Binding StartCaptureTargetCommand}"
                                        Content="{Binding CurrentRemapTargetText}"
                                        Style="{StaticResource KeyChipButtonStyle}"
                                        Foreground="#818CF8"
                                        ToolTip="Click to change target shortcut"/>
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="➔" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,10,4,0"/>

                            <!-- Node 3: Target Action -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ACTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <Border Background="#F1F5F9" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Height="28">
                                    <TextBlock Text="Toggle Mute" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#F1F5F9" Margin="0,2,0,6"/>

                        <!-- Direct Mute Toggle Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Microphone Mute" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Instant hardware stream cutoff" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsMuted, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Settings Flyout / Modal View -->
            <Border Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Settings Header -->
                        <Grid Margin="0,0,0,12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ADVANCED &amp; SETTINGS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ToggleSettingsCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Content="✕ Done" FontWeight="Bold" Foreground="{StaticResource AccentTeal}"/>
                        </Grid>

                        <!-- Preferences Rows -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Automatically launch on system boot" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start Minimized" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Launch quietly directly into system tray without opening window" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding StartMinimized, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Show Notifications" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="OS balloon popup when external apps alter volume and it is restored" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding ShowNotifications, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Persistent Desktop Mute Overlay" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Keep on-screen badge visible on desktop while muted" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding KeepOverlayWhenMuted, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Overlay Opacity" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding OverlayOpacityPercent, Mode=TwoWay}" Style="{StaticResource ModernSlider}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding OverlayOpacityPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#F1F5F9" Margin="0,4,0,12"/>

                        <!-- JSON Configuration & Backup -->
                        <TextBlock Text="JSON CONFIGURATION &amp; BACKUP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Text="Settings map directly to JSON. Backup and restore across machines or versions." FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding BackupSettingsCommand}" Content="Backup to JSON" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Grid.Column="2" Command="{Binding RestoreSettingsCommand}" Content="Restore JSON" Style="{StaticResource ActionButtonStyle}"/>
                        </Grid>

                        <Button Command="{Binding OpenSettingsFolderCommand}" Content="Open settings.json Folder" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,12"/>

                        <Border Height="1" Background="#F1F5F9" Margin="0,4,0,12"/>

                        <!-- Software Updates -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Software Updates" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}" Content="Check GitHub" Style="{StaticResource ActionButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 2. Minimalist Footer -->
        <TextBlock Grid.Row="2"
                   Text="Runs quietly in the system tray"
                   FontSize="10"
                   Foreground="{StaticResource TextMuted}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,6,0,2"/>
    </Grid>
</Window>
