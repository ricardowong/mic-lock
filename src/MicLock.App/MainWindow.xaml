<Window x:Class="MicLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MicLock.App"
        mc:Ignorable="d"
        Title="MicAnchor - Microphone Volume Lock &amp; Remap"
        Height="650" Width="440"
        MinHeight="600" MinWidth="420"
        Background="#F8FAFC"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"
        Icon="Assets/app.ico">

    <Window.Resources>
        <!-- Palette Tokens -->
        <SolidColorBrush x:Key="WindowBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#0284C7"/>
        <SolidColorBrush x:Key="AccentTealSoft" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="AccentTealBorder" Color="#BAE6FD"/>
        <SolidColorBrush x:Key="ActiveGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Fluent iOS / macOS Style Toggle Switch -->
        <Style x:Key="FluentToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                Background="#CBD5E1" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.2"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentTeal}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Key Chip Button Style -->
        <Style x:Key="KeyChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                                <Setter Property="Foreground" Value="#7DD3FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Secondary Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Continuous Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="5" CornerRadius="2.5" Background="{StaticResource AccentTeal}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="5" CornerRadius="2.5" Background="#E2E8F0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Grid Width="16" Height="16">
                                                    <Ellipse Fill="#FFFFFF" Stroke="{StaticResource AccentTeal}" StrokeThickness="2.5">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.2"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gradient VU Meter Bar Style -->
        <Style x:Key="GradientVuProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#E2E8F0" CornerRadius="2.5" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#10B981" Offset="0.0"/>
                                            <GradientStop Color="#0284C7" Offset="0.75"/>
                                            <GradientStop Color="#EF4444" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#F8FAFC"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      Data="M0,0 L3.5,3.5 L7,0"
                                                      Stroke="#64748B"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FFFFFF"
                                            BorderThickness="1"
                                            BorderBrush="#CBD5E1"
                                            CornerRadius="7"
                                            Margin="0,3,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.12"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,8">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Body Content (Cards or Settings) -->
            <RowDefinition Height="*"/>
            <!-- 2: Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Bar (Brand Icon + Title + Status Pill + Settings Gear) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Icon & App Title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentTealSoft}" BorderBrush="{StaticResource AccentTealBorder}" BorderThickness="1" Margin="0,0,10,0">
                    <!-- Apple SF-style crisp minimalist microphone vector glyph -->
                    <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Capsule -->
                        <Path Data="M8,1.5 C6.62,1.5 5.5,2.62 5.5,4 L5.5,8 C5.5,9.38 6.62,10.5 8,10.5 C9.38,10.5 10.5,9.38 10.5,8 L10.5,4 C10.5,2.62 9.38,1.5 8,1.5 Z" Fill="{StaticResource AccentTeal}"/>
                        <!-- Cradle Arc -->
                        <Path Data="M3.5,7 C3.5,9.48 5.52,11.5 8,11.5 C10.48,11.5 12.5,9.48 12.5,7" Stroke="{StaticResource AccentTeal}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <!-- Stem -->
                        <Path Data="M8,11.5 L8,14" Stroke="{StaticResource AccentTeal}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                        <!-- Base -->
                        <Path Data="M5.5,14 L10.5,14" Stroke="{StaticResource AccentTeal}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MicAnchor" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Volume Lock &amp; Remap" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Controls: Status Pill + Settings Gear -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{Binding StatusBackgroundBrush}"
                        BorderBrush="{Binding StatusBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="7,2"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5.5" Height="5.5" Fill="{Binding StatusBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Settings Gear Toggle Button -->
                <Button Command="{Binding ToggleSettingsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="3"
                        ToolTip="Settings &amp; Backup"
                        VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1. Body Content -->
        <Grid Grid.Row="1">

            <!-- MAIN DASHBOARD VIEW (3 Clean Unified Cards) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>

                    <!-- ========================================================================= -->
                    <!-- CARD 1: MICROPHONE & LEVEL -->
                    <!-- ========================================================================= -->
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,0,0,9">
                        <StackPanel>
                            <!-- Header Row with Cycle Next Link -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MICROPHONE &amp; LEVEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding CycleRecordingDeviceCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                    <TextBlock Text="Cycle Next ↻" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentTeal}"/>
                                </Button>
                            </Grid>

                            <!-- Audio Device ComboBox -->
                            <ComboBox ItemsSource="{Binding AvailableDevices}"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Target Volume Header & Readout -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Target Volume" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TargetVolumePercent, StringFormat='{}{0}%'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentTeal}"/>
                            </Grid>

                            <!-- Continuous Volume Slider -->
                            <Slider Minimum="0" Maximum="100"
                                    Value="{Binding TargetVolumePercent, Mode=TwoWay}"
                                    Style="{StaticResource ModernSlider}"
                                    Margin="0,0,0,8"/>

                            <!-- Live Input VU Meter -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LIVE INPUT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                             Value="{Binding CurrentVolumePercent, Mode=OneWay}"
                                             Style="{StaticResource GradientVuProgressBarStyle}"
                                             VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="#F1F5F9" Margin="0,0,0,8"/>

                            <!-- Toggle: Lock Volume Level -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Lock Volume Level" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Auto-restores level if other apps alter it" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsLocked, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                            </Grid>

                            <!-- Toggle: Mute Microphone -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mute Microphone" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Instantly cut off hardware stream" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsMuted, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========================================================================= -->
                    <!-- CARD 2: HARDWARE KEY REMAP -->
                    <!-- ========================================================================= -->
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,0,0,9">
                        <StackPanel>
                            <!-- Header Row with Remap Master Switch -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HARDWARE KEY REMAP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsKeyRemapEnabled, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                            </Grid>

                            <!-- Linear 3-Node Remapping Pipeline -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="8,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Node 1: Physical Input Key -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="INPUT KEY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                        <Button Command="{Binding StartCaptureInputCommand}"
                                                Content="{Binding CurrentInputKeyText}"
                                                Style="{StaticResource KeyChipButtonStyle}"
                                                ToolTip="Click to capture new hardware mic key"/>
                                    </StackPanel>

                                    <!-- Arrow 1 -->
                                    <TextBlock Grid.Column="1" Text="➔" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,8,4,0"/>

                                    <!-- Node 2: Remapped Target -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="REMAPPED AS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                        <Button Command="{Binding StartCaptureTargetCommand}"
                                                Content="{Binding CurrentRemapTargetText}"
                                                Style="{StaticResource KeyChipButtonStyle}"
                                                Foreground="#818CF8"
                                                FontSize="9.5"
                                                Padding="4,2"
                                                ToolTip="Click to capture remapped target shortcut"/>
                                    </StackPanel>

                                    <!-- Arrow 2 -->
                                    <TextBlock Grid.Column="3" Text="➔" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,8,4,0"/>

                                    <!-- Node 3: Executed Action -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="ACTION" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="5" Height="26" Padding="6,0">
                                            <TextBlock Text="Toggle Mute" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Subtext Status Row -->
                            <Grid Margin="2,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Suppresses Windows Key in OS" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="SendInput Active" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentTeal}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========================================================================= -->
                    <!-- CARD 3: SYSTEM & OVERLAY -->
                    <!-- ========================================================================= -->
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="11" Padding="14,11">
                        <StackPanel>
                            <TextBlock Text="SYSTEM &amp; OVERLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                            <!-- Start with Windows Toggle -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start with Windows" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                            </Grid>

                            <!-- Desktop Mute Overlay Toggle -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Desktop Mute Overlay" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding KeepOverlayWhenMuted, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                            </Grid>

                            <!-- Overlay Opacity Slider -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Overlay Opacity" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding OverlayOpacityPercent, Mode=TwoWay}" Style="{StaticResource ModernSlider}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding OverlayOpacityPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ========================================================================= -->
            <!-- ADVANCED SETTINGS FLYOUT DRAWER (Opened via ⚙) -->
            <!-- ========================================================================= -->
            <Border Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="14"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ADVANCED &amp; SETTINGS" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ToggleSettingsCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="✕ Done" FontWeight="Bold" Foreground="{StaticResource AccentTeal}"/>
                            </Button>
                        </Grid>

                        <!-- Preferences -->
                        <TextBlock Text="PREFERENCES" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start Minimized" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Launch quietly into tray on Windows boot" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding StartMinimized, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Show Notifications" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Balloon alerts when volume level is restored" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding ShowNotifications, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lock Active Microphone Endpoint" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Blocks external apps from switching default input mic" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsMicLockEnabled, Mode=TwoWay}" Style="{StaticResource FluentToggleSwitch}"/>
                        </Grid>

                        <Border Height="1" Background="#F1F5F9" Margin="0,0,0,10"/>

                        <!-- JSON Configuration & Backup -->
                        <TextBlock Text="JSON CONFIGURATION &amp; BACKUP" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <TextBlock Text="Settings map directly to JSON. Backup and restore across machines." FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding BackupSettingsCommand}" Content="Backup to JSON" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Grid.Column="2" Command="{Binding RestoreSettingsCommand}" Content="Restore JSON" Style="{StaticResource ActionButtonStyle}"/>
                        </Grid>

                        <Button Command="{Binding OpenSettingsFolderCommand}" Content="Open settings.json Folder" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,10"/>

                        <Border Height="1" Background="#F1F5F9" Margin="0,0,0,10"/>

                        <!-- Software Updates -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Software Updates" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}" Content="Check GitHub" Style="{StaticResource ActionButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 2. Minimalist Footer -->
        <Grid Grid.Row="2" Margin="4,6,4,2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="v1.3.0 (Up to date)" FontSize="10.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="GitHubLink_Click" VerticalAlignment="Center">
                <TextBlock Text="GitHub ↗" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentTeal}"/>
            </Button>
        </Grid>
    </Grid>
</Window>
