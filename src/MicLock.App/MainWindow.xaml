<Window x:Class="MicLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MicLock.App"
        mc:Ignorable="d"
        Title="MicLock - Microphone Volume Lock"
        Height="730" Width="470"
        MinHeight="690" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Icon="Assets/app.ico">

    <Window.Resources>
        <!-- Modern White Palette -->
        <SolidColorBrush x:Key="WindowBackground" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#059669"/>
        <SolidColorBrush x:Key="AccentGreenLight" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0284C7"/>

        <!-- Rounded Modern Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle CheckBox Style -->
        <Style x:Key="ModernToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Active Device -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Volume & Lock Controls -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Activity Log -->
            <RowDefinition Height="*"/>
            <!-- 4: Settings Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="🛡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MicLock" FontSize="21" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Border Margin="8,0,0,0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="v1.0" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Zero-latency WASAPI volume enforcement" FontSize="11" Foreground="#64748B" Margin="42,2,0,0"/>
            </StackPanel>

            <!-- Dynamic Status Pill Badge -->
            <Border Grid.Column="1"
                    Background="{Binding StatusBackgroundBrush}"
                    BorderBrush="{Binding StatusBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{Binding StatusForegroundBrush}"/>
            </Border>
        </Grid>

        <!-- 2. Active Microphone Card -->
        <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AUDIO RECORDING ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBlue}" FontSize="11" Cursor="Hand" Content="↻ Refresh"/>
                </Grid>

                <ComboBox ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          Background="#FFFFFF"
                          Foreground="#0F172A"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          Height="36"
                          Padding="8,6"
                          FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎤 " FontSize="12"/>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- 3. Volume & Lock Enforcement Card -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <!-- Protection Toggle -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Microphone Lock" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Text="Revert any external changes by Discord, Zoom, Steam, etc." FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsLocked, Mode=TwoWay}" VerticalAlignment="Center" Style="{StaticResource ModernToggleStyle}"/>
                </Grid>

                <!-- Target Volume Display -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LOCKED TARGET VOLUME" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Grid.Column="1" Text="{Binding TargetVolumePercent, StringFormat='{}{0}%'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                </Grid>

                <!-- Slider -->
                <Slider Minimum="0" Maximum="100"
                        Value="{Binding TargetVolumePercent, Mode=TwoWay}"
                        TickFrequency="5"
                        IsSnapToTickEnabled="False"
                        Margin="0,0,0,12"
                        Foreground="{StaticResource AccentGreenLight}"/>

                <!-- Quick Preset Buttons -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="50%" Command="{Binding SetPresetCommand}" CommandParameter="50" Style="{StaticResource PresetButtonStyle}"/>
                    <Button Grid.Column="1" Content="75%" Command="{Binding SetPresetCommand}" CommandParameter="75" Style="{StaticResource PresetButtonStyle}"/>
                    <Button Grid.Column="2" Content="80%" Command="{Binding SetPresetCommand}" CommandParameter="80" Style="{StaticResource PresetButtonStyle}"/>
                    <Button Grid.Column="3" Content="90%" Command="{Binding SetPresetCommand}" CommandParameter="90" Style="{StaticResource PresetButtonStyle}"/>
                    <Button Grid.Column="4" Content="100%" Command="{Binding SetPresetCommand}" CommandParameter="100" Style="{StaticResource PresetButtonStyle}"/>
                </Grid>

                <!-- Real-time Level Meter & Stats -->
                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Live Level:" FontSize="11" Foreground="#475569" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurrentVolumePercent, Mode=OneWay}" Height="7" Background="#E2E8F0" Foreground="{StaticResource AccentGreenLight}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding CurrentVolumePercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 4. Live Enforcement Event Log -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ENFORCEMENT ACTIVITY LOG" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <Border Margin="8,0,0,0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="6,1">
                            <TextBlock Text="{Binding PreventionCount, StringFormat='{}Blocked: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ClearLogsCommand}" Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="11" Cursor="Hand" Content="Clear"/>
                </Grid>

                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6">
                    <ListBox ItemsSource="{Binding ActivityLogs}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FormattedTime, StringFormat='{}[{0}] '}" FontSize="11" FontFamily="Consolas, monospace" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11" Foreground="#1E293B" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>

        <!-- 5. Preferences & Settings Footer -->
        <Border Grid.Row="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Content="Run on Startup" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" FontSize="11" Foreground="#334155" Cursor="Hand"/>
                <CheckBox Grid.Column="1" Content="Start Minimized" IsChecked="{Binding StartMinimized, Mode=TwoWay}" FontSize="11" Foreground="#334155" Cursor="Hand"/>
                <CheckBox Grid.Column="2" Content="Notifications" IsChecked="{Binding ShowNotifications, Mode=TwoWay}" FontSize="11" Foreground="#334155" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
