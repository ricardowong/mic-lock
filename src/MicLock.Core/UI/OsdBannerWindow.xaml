<Window x:Class="MicLock.Core.UI.OsdBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicLock OSD"
        Height="84" Width="290"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="BannerTransform" Y="0"/>
        </Grid.RenderTransform>

        <!-- SoundSwitch-Style Floating Dark Card -->
        <Border Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
            </Border.Effect>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Microphone Icon Glyph -->
                <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center">
                    <!-- Base Microphone Path -->
                    <Path x:Name="MicBodyPath"
                          Data="M12,2 A4,4 0 0,0 8,6 L8,12 A4,4 0 0,0 16,12 L16,6 A4,4 0 0,0 12,2 M5,10 L5,12 A7,7 0 0,0 11,18.92 L11,21 L8,21 A1,1 0 0,0 8,23 L16,23 A1,1 0 0,0 16,21 L13,21 L13,18.92 A7,7 0 0,0 19,12 L19,10 A1,1 0 0,0 17,10 L17,12 A5,5 0 0,1 7,12 L7,10 A1,1 0 0,0 5,10 Z"
                          Fill="#06B6D4"
                          Stretch="Uniform"
                          Width="22" Height="22"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Mute Slash Line (Visible only when muted) -->
                    <Line x:Name="MuteSlash"
                          X1="4" Y1="4" X2="28" Y2="28"
                          Stroke="#EF4444"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Visibility="Collapsed"/>
                </Grid>

                <!-- Text Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Microphone Off"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Microphone"
                               FontSize="12"
                               Foreground="#38BDF8"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
