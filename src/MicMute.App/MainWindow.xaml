<Window x:Class="MicMute.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicMute"
        Height="340" Width="380"
        MinHeight="340" MinWidth="380"
        MaxHeight="340" MaxWidth="380"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="7" Background="#F0FDFA" BorderBrush="#CCFBF1" BorderThickness="1" Margin="0,0,8,0">
                    <Path Data="M10,2 L18,5 L18,11 C18,16 14,19.5 10,21 C6,19.5 2,16 2,11 L2,5 Z" Fill="#0D9488" Width="13" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="MicMute" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Status Pill -->
            <Border x:Name="StatusPill" Grid.Column="1"
                    Background="#F0FDFA" BorderBrush="#CCFBF1" BorderThickness="1"
                    CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#0D9488" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLabel" Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Big Mute Toggle Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Circular Toggle Button -->
                <Button x:Name="ToggleMuteBtn" Grid.Row="0"
                        Width="90" Height="90" Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Click="OnToggleMuteClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="CircleBorder"
                                         Fill="{TemplateBinding Background}"
                                         StrokeThickness="3"
                                         Stroke="{TemplateBinding BorderBrush}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.18"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Width="40" Height="40">
                        <Path x:Name="BigMicPath"
                              Data="M12,2 A4,4 0 0,0 8,6 L8,12 A4,4 0 0,0 16,12 L16,6 A4,4 0 0,0 12,2 M5,10 L5,12 A7,7 0 0,0 11,18.92 L11,21 L8,21 A1,1 0 0,0 8,23 L16,23 A1,1 0 0,0 16,21 L13,21 L13,18.92 A7,7 0 0,0 19,12 L19,10 A1,1 0 0,0 17,10 L17,12 A5,5 0 0,1 7,12 L7,10 A1,1 0 0,0 5,10 Z"
                              Fill="#FFFFFF" Stretch="Uniform" Width="30" Height="30"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Line x:Name="BigMuteSlash"
                              X1="4" Y1="4" X2="36" Y2="36"
                              Stroke="#FFFFFF" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <!-- Action Button Label -->
                <TextBlock x:Name="ActionLabel" Grid.Row="1"
                           Text="CLICK TO MUTE"
                           FontSize="12" FontWeight="Bold"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,4"/>

                <!-- Device Name & Hotkey Hint -->
                <TextBlock x:Name="DeviceLabel" Grid.Row="2"
                           Text="Default Microphone"
                           FontSize="11" Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300"/>
            </Grid>
        </Border>

        <!-- Footer / Hotkey Info -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Hotkey: Ctrl + Shift + Alt + M" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock Text="PowerToys / keyboard mic key ready" FontSize="10" Foreground="#94A3B8"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Scroll Tray = Vol" FontSize="11" Foreground="#0D9488" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
