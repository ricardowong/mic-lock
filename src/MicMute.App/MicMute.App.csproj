<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MicLock.Core\MicLock.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MicMute</AssemblyName>
    <ApplicationIcon>..\MicLock.App\Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>MicMute</AssemblyTitle>
    <Product>MicMute</Product>
    <Description>Minimal Windows Microphone Mute Utility with SoundSwitch OSD</Description>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Company>MicLock Open Source Project</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\MicLock.App\Assets\*.ico" />
    <Content Include="..\MicLock.App\Assets\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
